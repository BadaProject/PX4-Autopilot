<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="boat">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.30 0 0 0</pose>
        <mass>850.0</mass>
        <inertia>
          <ixx>1100.0</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5200.0</iyy>
          <iyz>0</iyz>
          <izz>4200.0</izz>
        </inertia>
      </inertial>

      <collision name="rectangular_hull_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.7 0.50 0.90</size>
          </box>
        </geometry>
      </collision>

      <visual name="aura_hull_visual">
        <pose>0 0 1.78 0 0 3.141592653589793</pose>
        <geometry>
          <mesh>
            <uri>model://boat/meshes/Aura_low.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.18 0.19 0.20 1</ambient>
          <diffuse>0.18 0.19 0.20 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>

      <visual name="rectangular_hull_reference_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>3.7 0.50 0.90</size>
          </box>
        </geometry>
        <transparency>0.82</transparency>
        <material>
          <ambient>0.18 0.38 0.48 0.25</ambient>
          <diffuse>0.18 0.38 0.48 0.25</diffuse>
        </material>
      </visual>

      <velocity_decay>
        <linear>0.08</linear>
        <angular>0.85</angular>
      </velocity_decay>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.4 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <pose>0 0 1.2 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <link name="right_propeller_link">
      <pose relative_to="base_link">-3.7 -0.9 -0.15 0 1.570796 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.003</izz>
        </inertia>
      </inertial>
      <visual name="right_propeller_visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_propeller_link">
      <pose relative_to="base_link">-3.7 0.9 -0.15 0 1.570796 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.005</iyy>
          <iyz>0</iyz>
          <izz>0.003</izz>
        </inertia>
      </inertial>
      <visual name="left_propeller_visual">
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="right_propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_propeller_link</child>
      <pose relative_to="base_link">-3.7 -0.9 -0.15 0 1.570796 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-100000</lower>
          <upper>100000</upper>
          <effort>1000</effort>
          <velocity>200</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.001</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="left_propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_propeller_link</child>
      <pose relative_to="base_link">-3.7 0.9 -0.15 0 1.570796 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-100000</lower>
          <upper>100000</upper>
          <effort>1000</effort>
          <velocity>200</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.001</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="libGenericMotorModelPlugin.so" name="gz::sim::systems::GenericMotorModel">
      <jointName>right_propeller_joint</jointName>
      <linkName>right_propeller_link</linkName>
      <actuator_number>0</actuator_number>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.5</timeConstantUp>
      <timeConstantDown>0.5</timeConstantDown>
      <maxRotVelocity>100.0</maxRotVelocity>
      <motorConstant>0.025</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      <motorType>force_polynomial</motorType>
      <controlMethod>rpm</controlMethod>
      <minCommand>0.5</minCommand>
      <bidirectionalMotor>1</bidirectionalMotor>
      <positiveThrustPolynomial>[0.0, 2.5, 0.0, 0.0, 0.0, 0.0]</positiveThrustPolynomial>
      <negativeThrustPolynomial>[0.0, 0.75, 0.0, 0.0, 0.0, 0.0]</negativeThrustPolynomial>
    </plugin>

    <plugin filename="libGenericMotorModelPlugin.so" name="gz::sim::systems::GenericMotorModel">
      <jointName>left_propeller_joint</jointName>
      <linkName>left_propeller_link</linkName>
      <actuator_number>0</actuator_number>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.5</timeConstantUp>
      <timeConstantDown>0.5</timeConstantDown>
      <maxRotVelocity>100.0</maxRotVelocity>
      <motorConstant>0.025</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      <motorType>force_polynomial</motorType>
      <controlMethod>rpm</controlMethod>
      <minCommand>0.5</minCommand>
      <bidirectionalMotor>1</bidirectionalMotor>
      <positiveThrustPolynomial>[0.0, 2.5, 0.0, 0.0, 0.0, 0.0]</positiveThrustPolynomial>
      <negativeThrustPolynomial>[0.0, 0.75, 0.0, 0.0, 0.0, 0.0]</negativeThrustPolynomial>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>right_propeller_joint</joint_name>
      <joint_name>left_propeller_joint</joint_name>
    </plugin>
  </model>
</sdf>
