<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="boat">
    <pose>0 0 0.14 0 0 0</pose>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>0.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.0</iyy>
          <iyz>0</iyz>
          <izz>3.2</izz>
        </inertia>
      </inertial>

      <visual name="hull_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>2.0 0.8 0.32</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.86 1</ambient>
          <diffuse>0.9 0.9 0.86 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <visual name="bow_visual">
        <pose>1.08 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.72 0.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.9 1</ambient>
          <diffuse>0.95 0.95 0.9 1</diffuse>
        </material>
      </visual>

      <visual name="deck_visual">
        <pose>0.05 0 0.22 0 0 0</pose>
        <geometry>
          <box>
            <size>0.85 0.48 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.18 0.3 0.38 1</ambient>
          <diffuse>0.18 0.3 0.38 1</diffuse>
        </material>
      </visual>

      <velocity_decay>
        <linear>0.08</linear>
        <angular>0.25</angular>
      </velocity_decay>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <link name="propeller_link">
      <pose relative_to="base_link">-1.05 0 -0.12 0 1.570796 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="propeller_visual">
        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rudder_link">
      <pose relative_to="base_link">-1.0 0 -0.23 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0003</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="rudder_visual">
        <geometry>
          <box>
            <size>0.18 0.025 0.28</size>
          </box>
        </geometry>
        <material>
          <ambient>0.04 0.08 0.12 1</ambient>
          <diffuse>0.04 0.08 0.12 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="propeller_joint" type="revolute">
      <parent>base_link</parent>
      <child>propeller_link</child>
      <pose relative_to="base_link">-1.05 0 -0.12 0 1.570796 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-100000</lower>
          <upper>100000</upper>
          <effort>1000</effort>
          <velocity>200</velocity>
        </limit>
        <dynamics>
          <damping>0.02</damping>
          <friction>0.001</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rudder_joint" type="revolute">
      <parent>base_link</parent>
      <child>rudder_link</child>
      <pose relative_to="base_link">-1.0 0 -0.23 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5236</lower>
          <upper>0.5236</upper>
          <effort>20</effort>
          <velocity>2</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <plugin filename="libGenericMotorModelPlugin.so" name="gz::sim::systems::GenericMotorModel">
      <jointName>propeller_joint</jointName>
      <linkName>propeller_link</linkName>
      <motorNumber>0</motorNumber>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.08</timeConstantUp>
      <timeConstantDown>0.12</timeConstantDown>
      <maxRotVelocity>100.0</maxRotVelocity>
      <motorConstant>0.08</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <rotorDragCoefficient>0.0</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      <motorType>force_polynomial</motorType>
      <controlMethod>rpm</controlMethod>
      <minCommand>0.5</minCommand>
      <bidirectionalMotor>1</bidirectionalMotor>
      <positiveThrustPolynomial>[0.0, 0.12, 0.002, 0.0, 0.0, 0.0]</positiveThrustPolynomial>
      <negativeThrustPolynomial>[0.0, 0.10, 0.0015, 0.0, 0.0, 0.0]</negativeThrustPolynomial>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>50</p_gain>
      <i_gain>1</i_gain>
      <d_gain>0.1</d_gain>
    </plugin>

    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0</a0>
      <cla>3.0</cla>
      <cda>1.0</cda>
      <cma>0.0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>-1.0</cla_stall>
      <cda_stall>1.5</cda_stall>
      <cma_stall>0.0</cma_stall>
      <cp>-1.0 0 -0.23</cp>
      <area>0.05</area>
      <air_density>1000</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>rudder_link</link_name>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>propeller_joint</joint_name>
      <joint_name>rudder_joint</joint_name>
    </plugin>
  </model>
</sdf>
