<?xml version="1.0"?>
<model>
  <name>boat</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>PX4 Development Team</name>
    <email>dev@px4.io</email>
  </author>
  <description>
    Aura boat model for PX4 Gazebo SITL. The hull visual uses an OBJ extracted
    from the BadaSim Aura USD asset converted from AuraHull.stp, while the
    physics collision uses a simplified displacement volume for stable buoyancy.
  </description>
</model>
